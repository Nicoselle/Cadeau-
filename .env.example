# Copy to .env.local and adjust for your environment.

# Absolute base URL used in JSON-LD, sitemap, robots.txt and llms.txt.
# Defaults to the live Vercel URL (https://koppel-zeta.vercel.app) when unset.
# NEXT_PUBLIC_SITE_URL=https://kapitaalkrant.example

# Wachtwoord voor /safe (Safe Capital). Nico zet dit later.
# Leeg of ontbrekend = 401, nooit open. Geen default.
# SAFE_PASSWORD=
